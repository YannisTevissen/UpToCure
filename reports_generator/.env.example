# Copy this to .env and fill in the relevant keys.

# ----- LLM provider (default: OpenAI) ----------------------------------------
# Supported providers: openai | gemini | anthropic | ollama | lmstudio | vllm | custom
LLM_PROVIDER=openai

# Override the base URL of an OpenAI-compatible server (Ollama, vLLM, etc.).
# Examples:
#   Ollama:   http://localhost:11434/v1
#   LM Studio:http://localhost:1234/v1
#   vLLM:     http://localhost:8000/v1
#   Gemini:   https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_BASE_URL=

# Cross-provider API key. Falls back to the provider-specific env var below.
# LLM_API_KEY=

# Models. Cost-aware recommendation as of August 2026:
#   generation:   gpt-5.6-terra    ($2 in / $12 out per 1M tokens, ~$0.21/report)
#   translation:  gpt-5-nano       ($0.05 in / $0.40 out per 1M tokens)
LLM_MODEL=gpt-5.6-terra
# LLM_TRANSLATION_MODEL=gpt-5-nano

# Research backend: smolagents (default, free DuckDuckGo search, any provider),
# openai-responses (hosted web_search tool, OpenAI only, more robust unattended),
# or deep-research (o4-mini-deep-research, OpenAI only).
# RESEARCH_BACKEND=smolagents
# DEEP_RESEARCH_MODEL=o4-mini-deep-research
# DEEP_RESEARCH_MAX_TOOL_CALLS=25

# Self-updating refresh job (see refresh.py)
# MONTHLY_BUDGET_USD=30
# REFRESH_MAX_REPORTS_PER_RUN=4
# REFRESH_MAX_AGE_DAYS=30

# Content/state locations (defaults: in-repo UpToCure/reports and <reports>/.state)
# UPTOCURE_REPORTS_DIR=
# UPTOCURE_REQUESTS_DIR=
# UPTOCURE_STATE_DIR=

# Per-request timeout in seconds (research calls use RESEARCH_TIMEOUT_SECONDS, default 1800).
# LLM_TIMEOUT_SECONDS=120

# ----- Provider-specific keys -------------------------------------------------
OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ----- Optional: DeepL fallback for translator (--provider deepl) -------------
# DEEPL_API_KEY=
