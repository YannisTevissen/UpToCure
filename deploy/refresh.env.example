# Environment for the uptocure-refresh systemd service.
# Copy to /etc/uptocure/refresh.env and fill in the key:
#   sudo mkdir -p /etc/uptocure
#   sudo cp deploy/refresh.env.example /etc/uptocure/refresh.env
#   sudo chmod 600 /etc/uptocure/refresh.env

OPENAI_API_KEY=

LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-terra
LLM_TRANSLATION_MODEL=gpt-5-nano

# smolagents | openai-responses | deep-research (see reports_generator/backends.py)
RESEARCH_BACKEND=openai-responses

# Content lives outside the git checkout so deploys never clobber it.
UPTOCURE_REPORTS_DIR=/var/lib/uptocure/reports
UPTOCURE_REQUESTS_DIR=/var/lib/uptocure/disease_requests

# Hard cap: generation/translation stops once the ledger reaches this figure.
MONTHLY_BUDGET_USD=30
# 4 reports/day refreshes a ~100-disease catalog roughly monthly.
REFRESH_MAX_REPORTS_PER_RUN=4
REFRESH_MAX_AGE_DAYS=30
